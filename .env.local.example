# Скопируй этот файл в .env.local и заполни значения из Supabase Dashboard
# Settings → API. Без этих переменных приложение всё равно работает —
# профиль и партии хранятся в localStorage, а лидерборд показывает demo-данные.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiJ9...

# Опционально — для server-side операций
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiJ9...
